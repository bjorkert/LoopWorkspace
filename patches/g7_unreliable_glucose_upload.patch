+/// Uploads the G7 readings the sensor marks unreliable, live and backfilled, as "Unreliable Glucose" treatments, which
+/// LoopFollow shows as hollow orange dots. Loop itself never stores, shows or uses them.
+extension NightscoutService {
+    private static let unreliableGlucoseUploadedKey = "NightscoutService.unreliableGlucoseUploadedDates"
+    private static let unreliableGlucoseRemembered: TimeInterval = 24 * 60 * 60
+    private static let unreliableGlucoseQueue = DispatchQueue(label: "NightscoutService.unreliableGlucose", qos: .utility)
+
+    private struct UnreliableGlucoseTreatment: Encodable {
+        let eventType = "Unreliable Glucose"
+        let enteredBy = "Loop"
+        let glucoseType = "Sensor"
+        let units = "mg/dl"
+        let glucose: Int
+        let notes: String
+        let created_at: String
+    }
+
+    private func observeUnreliableGlucose() {
+        unreliableGlucoseObserver = NotificationCenter.default.addObserver(
+            forName: Notification.Name("G7UnreliableGlucoseReadings"),
+            object: nil,
+            queue: nil
+        ) { [weak self] notification in
+            guard let payload = notification.userInfo?["readings"] as? [[String: Any]] else { return }
+            let readings = payload.compactMap { reading -> (date: Date, mgdl: Int)? in
+                guard let date = reading["date"] as? Date, let mgdl = reading["mgdl"] as? Int else { return nil }
+                return (date, mgdl)
+            }
+            NightscoutService.unreliableGlucoseQueue.async {
+                self?.uploadUnreliableGlucose(readings)
+            }
+        }
+    }
+
+    /// Runs on `unreliableGlucoseQueue` only.
+    private func uploadUnreliableGlucose(_ readings: [(date: Date, mgdl: Int)]) {
+        guard let siteURL, let apiSecret, !apiSecret.isEmpty else {
+            log.default("Unreliable G7 readings not uploaded: Nightscout is not configured")
+            return
+        }
+
+        let defaults = UserDefaults.standard
+        let key = NightscoutService.unreliableGlucoseUploadedKey
+        let cutoff = Date().addingTimeInterval(-NightscoutService.unreliableGlucoseRemembered).timeIntervalSince1970
+        var uploaded = Set((defaults.array(forKey: key) as? [Double] ?? []).filter { $0 > cutoff })
+
+        var fresh: [(date: Date, mgdl: Int)] = []
+        for reading in readings.sorted(by: { $0.date < $1.date }) {
+            let seconds = reading.date.timeIntervalSince1970.rounded()
+            guard seconds > cutoff, uploaded.insert(seconds).inserted else { continue }
+            fresh.append(reading)
+        }
+        guard !fresh.isEmpty else { return }
+
+        let formatter = ISO8601DateFormatter()
+        let treatments = fresh.map {
+            UnreliableGlucoseTreatment(
+                glucose: $0.mgdl,
+                notes: "Unreliable reading (sensor issue): \($0.mgdl) mg/dL",
+                created_at: formatter.string(from: $0.date)
+            )
+        }
+        let hashedSecret = Insecure.SHA1.hash(data: Data(apiSecret.utf8)).map { String(format: "%02x", $0) }.joined()
+
+        var request = URLRequest(url: siteURL.appendingPathComponent("api/v1/treatments.json"))
+        request.httpMethod = "POST"
+        request.timeoutInterval = 30
+        request.addValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.addValue(hashedSecret, forHTTPHeaderField: "api-secret")
+        do {
+            request.httpBody = try JSONEncoder().encode(treatments)
+        } catch {
+            log.error("Unreliable G7 readings not encoded: %{public}@", String(describing: error))
+            return
+        }
+
+        let summary = fresh.map { "\($0.mgdl)" }.joined(separator: ", ")
+        URLSession.shared.dataTask(with: request) { [log] _, response, error in
+            guard error == nil, let http = response as? HTTPURLResponse, 200..<300 ~= http.statusCode else {
+                log.error("Unreliable G7 reading upload failed: %{public}@", String(describing: error ?? URLError(.badServerResponse)))
+                return
+            }
+            NightscoutService.unreliableGlucoseQueue.async {
+                let cutoff = Date().addingTimeInterval(-NightscoutService.unreliableGlucoseRemembered).timeIntervalSince1970
+                var stored = Set((defaults.array(forKey: key) as? [Double] ?? []).filter { $0 > cutoff })
+                fresh.forEach { stored.insert($0.date.timeIntervalSince1970.rounded()) }
+                defaults.set(Array(stored), forKey: key)
+            }
+            log.default("Uploaded unreliable G7 readings: %{public}@ mg/dL", summary)
+        }.resume()
+    }
+}
